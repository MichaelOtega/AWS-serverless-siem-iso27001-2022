{
	"id": "<REDACTED_DATADOG_MONITOR_ID>",
	"name": "AWS Console Login Detected",
	"type": "log alert",
	"query": "logs(\"source:cloudtrail @evt.name:ConsoleLogin\").index(\"*\").rollup(\"count\").last(\"5m\") > 0",
	"message": "🚨 *Urgent-AWS Console Login Detected!* A user has accessed the AWS environment.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n@slack-aws-alerts",
	"tags": [],
	"options": {
		"thresholds": {
			"critical": 0
		},
		"enable_logs_sample": false,
		"notify_audit": false,
		"on_missing_data": "default",
		"include_tags": false,
		"groupby_simple_monitor": false,
		"new_host_delay": 300
	},
	"priority": null,
	"draft_status": "published",
	"assets": []
}
